{
  "default": {
    "require": [
      "support/hooks.ts",
      "tests/step-definitions/**/*.ts"
    ],
    "paths": [
      "features/**/*.feature"
    ],
    "requireModule": [
      "ts-node/register"
    ],
    "format": [
      "progress-bar",
      "allure-cucumberjs/reporter",
      "html:reports/cucumber-report.html"
    ],
    "formatOptions": {
      "resultsDir": "reports/allure-results"
    },
    "publishQuiet": true
  }
}